{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bio-monitor",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  // Worker statis untuk bioenergi-plnepi.bio; push ke main men-deploy lewat Workers Builds.
  // Worker statis tidak mengirim ETag/Last-Modified, jadi pemantau versi di index.html
  // (V239) membaca commit SHA dari version.txt yang ditulis build ini.
  "build": {
    "command": "git rev-parse HEAD > version.txt"
  },
  // Yang tersaji hanya berkas situs; sisanya disaring .assetsignore.
  "assets": {
    "directory": "."
  }
}
